# The cluster these manifests deploy to: the only place these values live (none of them is a secret).
# They come from `terraform output` in virology-lab-hackathon-infra; update them here after the infrastructure changes.
AWS_REGION=us-east-1
EKS_CLUSTER=virology-lab-cluster
SECRET_PREFIX=virology-lab-forms-validation
BACKEND_ROLE_ARN=arn:aws:iam::475568920419:role/virology-lab-forms-validation-backend
FILES_BUCKET=virology-lab-forms-validation-files-475568920419
DOMAIN=virolab.site
CERTIFICATE_ARN=arn:aws:acm:us-east-1:475568920419:certificate/7a8f6f39-471c-4e46-9c52-880d984f497d
# Source addresses allowed through the ALB, comma-separated ("0.0.0.0/0" = everyone, behind the login screen).
ALLOWED_CIDRS=0.0.0.0/0
# false runs only the local extraction stages (no AI tokens).
LLM_ENABLED=true
